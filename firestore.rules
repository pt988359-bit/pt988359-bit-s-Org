rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Unmatched Documents
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Core Identity & Primitive Security Helpers
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        ('providerData' in request.auth &&
         request.auth.providerData is list &&
         request.auth.providerData.size() > 0 &&
         'providerId' in request.auth.providerData[0] &&
         request.auth.providerData[0].providerId == 'google.com')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null &&
         request.auth.token.email.matches('.*@proteck\\.com$') &&
         isEmailVerified())
      );
    }

    // =========================================================================
    // Input Validation Schemas
    // =========================================================================

    function isValidProduct(data) {
      return (
        (('name' in data && data.name is string && data.name.size() >= 2 && data.name.size() <= 200) ||
         ('title' in data && data.title is string && data.title.size() >= 2 && data.title.size() <= 200)) &&
        data.price is number && data.price >= 0 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 10))
      );
    }

    function isValidReservation(data) {
      return (
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.status in ['pending', 'active', 'new', 'waiting_customer'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false) &&
        (!('priceDiscount' in data) || data.priceDiscount == 0) &&
        (!('isApproved' in data) || data.isApproved == false)
      );
    }

    function isValidOrder(data) {
      return (
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
        (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0)) &&
        data.status in ['pending', 'new', 'active'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false) &&
        (!('priceDiscount' in data) || data.priceDiscount == 0)
      );
    }

    function isValidPurchaseRequest(data) {
      return (
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
        data.status in ['pending', 'new', 'active'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false)
      );
    }

    function isValidNegotiation(data) {
      return (
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
        data.status in ['pending', 'new', 'active'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false)
      );
    }

    function isValidInquiry(data) {
      return (
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
        data.status in ['pending', 'new', 'active'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false)
      );
    }

    function isValidSellOrExchange(data) {
      return (
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
        data.status in ['pending', 'new', 'active'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false)
      );
    }

    function isValidCustomerRequest(data) {
      return (
        data.type in ['reservation', 'purchase', 'negotiation', 'sell_device', 'trade_in', 'inquiry'] &&
        data.customer is map &&
        data.customer.fullName is string && data.customer.fullName.size() >= 2 && data.customer.fullName.size() <= 100 &&
        data.customer.phone is string && data.customer.phone.size() >= 8 && data.customer.phone.size() <= 20 &&
        data.status in ['new', 'pending_approval', 'active', 'pending'] &&
        (!('isAdminApproved' in data) || data.isAdminApproved == false) &&
        (!('priceDiscount' in data) || data.priceDiscount == 0)
      );
    }

    function isValidAuditLog(data) {
      return data.timestamp is string || data.timestamp is timestamp;
    }

    function isValidReview(data) {
      return (
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000))
      );
    }

    // =========================================================================
    // 1. ADMINS COLLECTION (Strict Superadmin RBAC)
    // =========================================================================
    match /admins/{adminId} {
      // Strictly prevent shadow admin injection: read and write ONLY if already admin
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 2. PUBLIC PRODUCT CATALOG & TAXONOMIES
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. CUSTOMER & USER ACCOUNTS (PII Protection)
    // =========================================================================
    match /customers/{customerId} {
      allow read, update: if isOwner(customerId) || isAdmin();

      allow create: if isAdmin() || (
        isOwner(customerId) &&
        (incoming().id == customerId || incoming().firebaseUid == customerId) &&
        (!('totalPurchases' in incoming()) || incoming().totalPurchases == 0) &&
        (!('totalSpent' in incoming()) || incoming().totalSpent == 0) &&
        (!('totalReservations' in incoming()) || incoming().totalReservations == 0) &&
        (!('totalRequests' in incoming()) || incoming().totalRequests == 0) &&
        (!('isArchived' in incoming()) || incoming().isArchived == false)
      );

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 4. RESERVATIONS & ORDERS (Public Create, Admin Read/Update/Delete)
    // =========================================================================
    match /reservations/{reservationId} {
      allow create: if isValidId(reservationId) && isValidReservation(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /completed_sales/{saleId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 5. CUSTOMER ACTION REQUESTS (Public Create with Schema Validation, Admin Manage)
    // =========================================================================
    match /customer_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidCustomerRequest(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /purchase_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidPurchaseRequest(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /negotiations/{negotiationId} {
      allow create: if isValidId(negotiationId) && isValidNegotiation(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /sell_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidSellOrExchange(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /exchange_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidSellOrExchange(incoming());
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. BACKOFFICE FINANCE & BUSINESS SENSITIVE COLLECTIONS (Admin Only)
    // =========================================================================
    match /finance/{financeId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /cash_ledgers/{ledgerId} {
      allow read, write: if isAdmin();
    }

    match /cost_sheets/{sheetId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /procurement/{procurementId} {
      allow read, write: if isAdmin();
    }

    match /purchase_history/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /financial_timeline/{timelineId} {
      allow read, write: if isAdmin();
    }

    match /financial_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Support legacy and prefixed collections
    match /proteck_admin_expenses_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_cash_ledger_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_cost_sheets_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_procurement_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_suppliers_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_purchase_history_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_financial_timeline_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /proteck_admin_financial_alerts_v1/{id} {
      allow read, write: if isAdmin();
    }

    match /showroom_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /documents/{documentId} {
      allow read, write: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read, write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow read, write: if isAdmin();
    }

    match /portal_tracking/{trackingId} {
      allow read, write: if isAdmin();
    }

    match /portal_sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /auth_sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /auth_attempts/{attemptId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 7. SYSTEM LOGS (Immutable Write, Admin-Only Read)
    // =========================================================================
    match /audit_logs/{logId} {
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /auth_logs/{logId} {
      allow create: if isValidId(logId);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // 8. NOTIFICATIONS, REVIEWS & KNOWLEDGE (Public Read, Controlled Write)
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isAdmin();
    }

    match /ai_knowledge/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portal_support/{ticketId} {
      allow create: if isValidId(ticketId);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. ATOMIC SEQUENCE COUNTERS
    // =========================================================================
    match /sequence_counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
